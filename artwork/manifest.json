    { "name": "snow", "id": "weather.snow", "file": "snow.svg", "description": "Snow" },
    { "name": "thunderstorm", "id": "weather.thunderstorm", "file": "thunderstorm.svg", "description": "Thunderstorm" },
    { "name": "wind", "id": "weather.wind", "file": "wind.svg", "description": "Wind" },
